<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            styleClass="login-root"
            stylesheets="@login.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.csc311m3labtwo.HelloController">

    <left>
        <VBox alignment="CENTER_LEFT"
              prefWidth="355.0"
              spacing="12.0"
              styleClass="brand-panel">
            <padding>
                <Insets bottom="55.0" left="48.0" right="40.0" top="55.0"/>
            </padding>

            <Label text="FSC" styleClass="brand-badge"/>
            <Label text="Welcome to your&#10;student portal"
                   styleClass="brand-heading"/>
            <Label text="Access your campus tools, information, and account from one place."
                   wrapText="true"
                   styleClass="brand-copy"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER"
              spacing="18.0"
              styleClass="form-area">
            <VBox maxWidth="340.0" spacing="13.0" styleClass="login-card">
                <padding>
                    <Insets bottom="34.0" left="34.0" right="34.0" top="34.0"/>
                </padding>

                <Label text="Sign In" styleClass="login-title"/>
                <Label text="Use your Farmingdale account to continue."
                       wrapText="true"
                       styleClass="login-subtitle"/>

                <Label text="USERNAME" styleClass="field-label"/>
                <TextField promptText="Enter username" styleClass="login-field"/>

                <Label text="PASSWORD" styleClass="field-label"/>
                <PasswordField promptText="Enter password" styleClass="login-field"/>

                <Button maxWidth="Infinity"
                        text="LOGIN"
                        styleClass="login-button"
                        onAction="#openLanding"/>

                <Button maxWidth="Infinity"
                        text="CREATE ACCOUNT"
                        styleClass="create-button"
                        onAction="#openRegistration"/>

                <Button maxWidth="Infinity"
                        text="CANCEL"
                        styleClass="cancel-button"
                        onAction="#closeApp"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
